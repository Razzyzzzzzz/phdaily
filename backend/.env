# --- Database (XAMPP MySQL default: user root, no password) ---
# Create the database first:  CREATE DATABASE everyday_life CHARACTER SET utf8mb4;
DATABASE_URL="mysql://root:@localhost:3306/everyday_life"

# --- Auth ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins (your Vercel URL, etc.)
CLIENT_ORIGINS="http://localhost:5173"
# In development, also accept any localhost / private-LAN origin
# (192.168.x.x, 10.x.x.x, 172.16-31.x.x) so phones on your Wi-Fi can connect.
ALLOW_LAN=true
# Set to true when running behind a proxy (Render, Railway, Nginx...) so rate limits see real IPs
TRUST_PROXY=false
